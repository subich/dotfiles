# https://ghostty.org/docs/config/reference

# Ghostty renders the terminal; tmux owns sessions, windows, and panes.
theme = Apple System Colors

font-family = "BerkeleyMono Nerd Font"
font-size = 13
font-thicken = true
font-thicken-strength = 1

background-blur = macos-glass-regular
background-opacity = 1.0
background-opacity-cells = true
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = transparent
macos-window-buttons = hidden
window-step-resize = true
window-theme = system

adjust-cell-height = 1
adjust-cursor-thickness = 1
adjust-underline-position = 6
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0

mouse-hide-while-typing = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify

# Start the first Ghostty surface in the persistent main tmux session. Later
# surfaces, including the quick terminal, use the normal login shell.
initial-command = /bin/zsh -l -c "/opt/homebrew/bin/tmux new-session -A -s main"

quick-terminal-position = top
quick-terminal-size = 500px,80%

# Keep Ghostty defaults; only unbind keys that conflict with tmux.
keybind = global:super+grave_accent=toggle_quick_terminal

# Disable Ghostty tab/split actions — tmux owns these.
keybind = super+t=unbind
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+shift+enter=unbind
keybind = super+shift+right_bracket=unbind
keybind = super+shift+left_bracket=unbind
keybind = super+one=unbind
keybind = super+two=unbind
keybind = super+three=unbind
keybind = super+four=unbind
keybind = super+five=unbind
keybind = super+six=unbind
keybind = super+seven=unbind
keybind = super+eight=unbind
keybind = super+nine=unbind

macos-option-as-alt = true
